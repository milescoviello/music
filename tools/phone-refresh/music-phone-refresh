#!/usr/bin/env python3
"""Keep the Music app on the iPhone current and signed, whenever the phone is plugged in.

A free Apple developer certificate signs an app for seven days, and every push to `main`
publishes a new build to the repo's rolling `latest` release. This watches for the phone
on USB and, every time it is plugged in, installs `latest` — whatever the phone already
has, so plugging in is always a fresh signature and the newest build. While the phone
stays plugged in it also installs any build published since, and retries a failed
install every ten minutes.

Plugged in means on USB (lsusb), not listed by usbmuxd: usbmuxd can lose sight of a phone
that never left, and seeing it again is not a new plug-in. The install waits for the
re-enumeration an iPhone does by itself 20 to 35 seconds after it is plugged in (or a
minute, if it does not), and for usbmuxd to have listed it for 15 seconds since.

Runs in the desktop session (KDE autostart), so it can notify and use the logged-in
`gh` and `xtool`. State is in ~/.local/state/music-phone-refresh/state.json, the log
beside it. tools/phone-refresh/test-music-phone-refresh replays plug-ins against fake
tools.

Two things learned the hard way, from the app's own notes:
- Never time out `xtool install`. A killed install leaves a session that collides with
  the next one ("Coordinator superseded"). It is run to completion here, however long.
- If it stalls at [Verifying], the app is playing music: iOS will not replace an app
  holding an active audio session. The notification says so.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

REPO = "milescoviello/music"
STATE_DIR = Path.home() / ".local" / "state" / "music-phone-refresh"
CACHE = Path.home() / ".cache" / "music-phone"
STATE = STATE_DIR / "state.json"
LOG = STATE_DIR / "log.txt"

POLL_SECONDS = 5
# An iPhone re-enumerates by itself 20 to 35 seconds after it is plugged in: off USB for 3 to
# 9 seconds, back as a new device. It is unplugged only once it has been off USB this long.
UNPLUG_SECONDS = 15
# That re-enumeration cuts off an install started before it, so the first waits for it, or
# for this long after plugging in if the phone does not.
REENUMERATE_SECONDS = 60
# And usbmuxd must have listed the phone this long, as the same USB device.
SETTLE_SECONDS = 15
# On USB but not listed by usbmuxd this long, the notification says so. The usbmuxd
# watchdog restarts usbmuxd after 30 s of that, which is usually enough.
UNLISTED_WARN_SECONDS = 60
# While plugged in, how often to look for a newer build.
RELEASE_CHECK_SECONDS = 15 * 60
# After a failed install, before trying again while still plugged in.
RETRY_SECONDS = 10 * 60


def log(message: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    line = f"{datetime.now().isoformat(timespec='seconds')} {message}"
    print(line, flush=True)
    with LOG.open("a") as handle:
        handle.write(line + "\n")
    # Keep the log to the last few hundred lines.
    lines = LOG.read_text().splitlines()
    if len(lines) > 500:
        LOG.write_text("\n".join(lines[-400:]) + "\n")


# Started from KDE autostart this is set; started from anywhere else it may not be, and
# notifications would vanish. The session bus is at a fixed place for a logged-in user.
if "DBUS_SESSION_BUS_ADDRESS" not in os.environ and Path(f"/run/user/{os.getuid()}/bus").exists():
    os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{os.getuid()}/bus"


def notify(title: str, body: str, urgent: bool = False) -> None:
    command = ["notify-send", "--app-name=Music", "--icon=multimedia-player", title, body]
    if urgent:
        command.insert(1, "--urgency=critical")
    subprocess.run(command, check=False, capture_output=True)


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2))


def attached_phone() -> str | None:
    """The UDID of the phone usbmuxd lists, or None. A phone on USB that usbmuxd does not
    list is told apart by `usb_iphone`."""
    try:
        result = subprocess.run(["idevice_id", "-l"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    ids = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return ids[0] if result.returncode == 0 and ids else None


def usb_iphone() -> str | None:
    """Where an iPhone is on USB ("Bus 003 Device 012"), or None. The device number is new
    each time the phone is plugged in or re-enumerates."""
    try:
        result = subprocess.run(["lsusb"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"^(Bus \d+ Device \d+): ID 05ac:12", result.stdout, re.MULTILINE)
    return match.group(1) if match else None


def latest_release() -> dict | None:
    """{'build': '105', 'commit': '194ed8a', 'published': '...'} for the `latest` release."""
    try:
        result = subprocess.run(
            ["gh", "release", "view", "latest", "--repo", REPO, "--json", "body,publishedAt"],
            capture_output=True, text=True, timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    data = json.loads(result.stdout)
    match = re.search(r"Build (\d+) · commit (\w+)", data.get("body", ""))
    return {
        "build": match.group(1) if match else None,
        "commit": match.group(2) if match else None,
        "published": data.get("publishedAt"),
    }


def newer_build(state: dict, udid: str, release: dict | None) -> str | None:
    """Why a build published since the last install is due, or None."""
    installed = state.get("installed", {}).get(udid)
    if release and release.get("published") and release["published"] != (installed or {}).get("published"):
        return f"build {release.get('build')} is out (phone has {(installed or {}).get('build')})"
    return None


def install(udid: str, release: dict | None) -> bool:
    CACHE.mkdir(parents=True, exist_ok=True)
    download = subprocess.run(
        ["gh", "release", "download", "latest", "--repo", REPO, "-p", "Music.ipa", "-D", str(CACHE), "--clobber"],
        capture_output=True, text=True,
    )
    if download.returncode != 0:
        log(f"download failed: {download.stderr.strip()[-300:]}")
        notify("Music: couldn't download the build", download.stderr.strip()[-200:] or "gh release download failed")
        return False

    build = release.get("build") if release else "?"
    notify("Music: installing build " + str(build), "Keep the phone plugged in. If it sits at Verifying, stop playback in Music.")
    log(f"installing build {build} on {udid}")

    # No timeout, deliberately — see the module docstring.
    process = subprocess.run(
        ["xtool", "install", "--usb", "--udid", udid, str(CACHE / "Music.ipa")],
        capture_output=True, text=True,
    )
    output = (process.stdout + process.stderr).strip()
    if process.returncode == 0:
        log(f"installed build {build}")
        notify("Music: build " + str(build) + " installed", "Signed for the next seven days.")
        return True

    last = output.splitlines()[-1] if output else "xtool install failed"
    log(f"install failed: {last[-500:]}")
    hint = ""
    if "no current IOS devices" in output:
        hint = " Apple hasn't registered the phone on the team yet — it usually works on the next try."
    notify("Music: install failed", last[-200:] + hint, urgent=True)
    return False


@dataclass
class Plug:
    """The phone's time on USB, from plugging in to unplugging. Neither a re-enumeration
    nor usbmuxd losing sight of the phone ends it."""
    since: float
    usb: str  # "Bus 003 Device 012", new when the phone re-enumerates
    reenumerated: bool = False
    owed: bool = True  # plugging in always installs, once
    off_usb_since: float | None = None
    listed_since: float | None = None  # by usbmuxd, as this USB device
    unlisted_since: float | None = None
    warned_unlisted: bool = False
    next_try: float = 0.0  # after a failed install


def main() -> None:
    log("watching for the iPhone")
    plug: Plug | None = None
    last_release_check = 0.0
    release: dict | None = None

    while True:
        time.sleep(POLL_SECONDS)
        now = time.time()
        usb = usb_iphone()
        udid = attached_phone()
        if usb is None and udid is not None:
            # idevice_id lists only phones on USB, so lsusb missed it.
            usb = plug.usb if plug else "listed by usbmuxd"

        if usb is None:
            if plug is not None:
                if plug.off_usb_since is None:
                    plug.off_usb_since = now
                if now - plug.off_usb_since >= UNPLUG_SECONDS:
                    log("phone unplugged")
                    plug = None
            continue

        if plug is None:
            plug = Plug(now, usb)
            log(f"phone plugged in ({usb})")
        plug.off_usb_since = None
        if usb != plug.usb:
            log(f"phone re-enumerated ({usb})")
            plug.usb = usb
            plug.reenumerated = True
            plug.listed_since = None

        if udid is None:
            # On USB, but usbmuxd does not list it: wedged, or the phone is not letting it in.
            # Only root can restart usbmuxd; say so once, after the watchdog has had its go.
            plug.listed_since = None
            if plug.unlisted_since is None:
                plug.unlisted_since = now
            if now - plug.unlisted_since >= UNLISTED_WARN_SECONDS and not plug.warned_unlisted:
                plug.warned_unlisted = True
                log("iPhone on USB but usbmuxd has not listed it for a minute")
                notify(
                    "Music: phone connected but not visible",
                    "usbmuxd has not listed it for a minute. If the phone is locked, unlock it. usbmuxd's "
                    "watchdog restarts it, three times and again ten minutes later; to restart it now: "
                    "sudo rc-service usbmuxd restart",
                    urgent=True,
                )
            continue

        if plug.warned_unlisted:
            log("usbmuxd lists the phone now")
        plug.unlisted_since = None
        plug.warned_unlisted = False
        if plug.listed_since is None:
            plug.listed_since = now
            log(f"usbmuxd lists it: {udid}")
        if now - plug.listed_since < SETTLE_SECONDS or now < plug.next_try:
            continue
        if not plug.reenumerated and now - plug.since < REENUMERATE_SECONDS:
            continue

        # Fresh for an install owed to the plug-in, so the log names the build it installs.
        if plug.owed or now - last_release_check > RELEASE_CHECK_SECONDS:
            release = latest_release() or release
            last_release_check = now

        state = load_state()
        reason = "phone plugged in" if plug.owed else newer_build(state, udid, release)
        if not reason:
            continue
        log(f"install due: {reason}")
        if not install(udid, release):
            plug.next_try = time.time() + RETRY_SECONDS
            continue
        plug.owed = False
        state.setdefault("installed", {})[udid] = {
            "build": release.get("build") if release else None,
            "commit": release.get("commit") if release else None,
            "published": release.get("published") if release else None,
            "at": time.time(),
        }
        save_state(state)


if __name__ == "__main__":
    # One instance only: a second, from a re-login or a manual start, would race the first
    # for the same install.
    import fcntl
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = open(STATE_DIR / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    while True:
        try:
            main()
        except KeyboardInterrupt:
            sys.exit(0)
        except Exception as error:  # noqa: BLE001 — a watcher that dies is no watcher
            log(f"watcher error, restarting in a minute: {error!r}")
            time.sleep(60)
