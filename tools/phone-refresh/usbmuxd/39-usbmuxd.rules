# usbmuxd (Apple Mobile Device Muxer listening on /var/run/usbmuxd)
# Overrides /lib/udev/rules.d/39-usbmuxd.rules: usbmuxd is the OpenRC service
# /etc/init.d/usbmuxd now, not started per plug-in by udev (see that script for why).
# Nor does udev set the device's USB configuration any more. The package's rule resets it
# to 0 on every add, for a usbmuxd that udev starts afterwards. A usbmuxd already running
# has configured the phone by the time the rule runs, so the reset unconfigured it again,
# and usbmuxd logged "Removed device" and never saw it come back.

# systemd should receive all events relating to device
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="5ac/12[9a][0-9a-f]/*|5ac/190[1-5]/*|5ac/8600/*", TAG+="systemd"

# Give iOS devices to the usbmux user (no configuration change: see above)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="5ac/12[9a][0-9a-f]/*|5ac/190[1-5]/*", ACTION=="add", ENV{USBMUX_SUPPORTED}="1", OWNER="usbmux"
# and the iBridge (T1) too
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="5ac/8600/*", ACTION=="add", ENV{USBMUX_SUPPORTED}="1", OWNER="usbmux"


# Make sure properties don't get lost when bind action is called
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="5ac/12[9a][0-9a-f]/*|5ac/190[1-5]/*|5ac/8600/*", ACTION=="bind", ENV{USBMUX_SUPPORTED}="1", OWNER="usbmux"

# (No exit on removal: the usbmuxd OpenRC service runs all the time.)
